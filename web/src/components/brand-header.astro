---
interface Props {
	tagline?: string
}

const { tagline = 'Dinner from what you already have' } = Astro.props
---

<header class="animate-rise mx-auto max-w-3xl px-6 pt-14 pb-8 sm:pt-20">
	<p
		class="font-display text-5xl leading-none tracking-tight text-ink sm:text-7xl"
	>
		Meal Planner
	</p>
	<h1
		class="font-display mt-5 max-w-xl text-2xl leading-snug font-semibold text-ink-soft sm:text-3xl"
	>
		{tagline}
	</h1>
	<p class="mt-4 max-w-lg text-base leading-relaxed text-ink-soft/90 sm:text-lg">
		Build a pantry-first dinner plan that respects your budget, calories, and
		allergens — then get a shopping list for only what you still need.
	</p>
</header>
