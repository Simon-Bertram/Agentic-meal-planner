{
  "name": "meal-planner-web",
  "compatibility_date": "2025-11-24",
  "compatibility_flags": ["nodejs_compat"],
  // Paste id and preview_id after:
  //   pnpm exec wrangler kv namespace create MEAL_PLANNER_QUOTAS
  //   pnpm exec wrangler kv namespace create MEAL_PLANNER_QUOTAS --preview
  "kv_namespaces": [
    {
      "binding": "MEAL_PLANNER_QUOTAS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_ID"
    }
  ]
}
